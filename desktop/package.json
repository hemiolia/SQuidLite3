{
  "name": "squidlite3-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "SQuidLite3 デスクトップ窓（試作）",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "stage": "node tools/stage.js",
    "pack": "npm run stage && electron-packager . SQuidLite3 --platform=darwin --arch=arm64 --out=dist --overwrite --prune=true --ignore=\"^/(dist|out|proof|tools)\" --extra-resource=out/stage/repo",
    "pack:py": "npm run stage && electron-packager . SQuidLite3 --platform=darwin --arch=arm64 --out=dist --overwrite --prune=true --ignore=\"^/(dist|out|proof|tools)\" --extra-resource=out/stage/repo --extra-resource=out/pbs/python"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
